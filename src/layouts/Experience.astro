---
import '../styles/tokens.css';
// Self-hosted latin-subset fonts (@fontsource) — replaces the Google Fonts CDN link
// (GDPR IP transfer + render-blocking third-party origin). Only the weights in use:
// Chakra Petch 500/700 (default-weight display text resolves to 500, as it always has),
// Space Mono 400/700.
import '@fontsource/chakra-petch/latin-500.css';
import '@fontsource/chakra-petch/latin-700.css';
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-700.css';
import chakra700Url from '@fontsource/chakra-petch/files/chakra-petch-latin-700-normal.woff2?url';
import 'locomotive-scroll/dist/locomotive-scroll.css';
import '../styles/app.css';
import { site, links as defaultLinks, sources } from '../config/site.config';
import Nav from '../components/Nav.astro';
import banner from '../generated/banner.txt?raw';
import { getConnectLinks } from '../lib/data';
import { externalAttrs, isSafeHref } from '../lib/safe';

interface Props { title?: string; description?: string; noindex?: boolean }
const { title, description: descProp, noindex = false } = Astro.props;
const pageTitle = title || `${site.name} — ${site.tagline}`;
const description = descProp || site.description;
import { base } from '../lib/base';    // '/showcase/' — guaranteed trailing slash
// Per-page canonical: Astro.url.pathname carries the page's own path (incl. base) at build
// time, so detail pages canonicalize to themselves — not to the homepage.
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), site.url).href;
const ogImage = site.url + base + 'og.png';
// Connect links: CMS singleton if present, else the defaults in site.config.
// Scheme-allowlisted — a poisoned CMS value must never render as a clickable href.
const links = getConnectLinks(defaultLinks).filter((l) => isSafeHref(l.href));
const year = new Date().getFullYear();
const home = site.url + base; // https://mrk-exe.github.io/showcase/
// Person + WebSite structured data for search + rich results
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': home + '#person',
      name: site.author,
      url: home,
      image: ogImage,
      jobTitle: site.tagline,
      description: site.description,
      sameAs: links.filter((l) => /^https?:/.test(l.href)).map((l) => l.href),
    },
    {
      '@type': 'WebSite',
      '@id': home + '#website',
      url: home,
      name: site.name,
      description: site.description,
      publisher: { '@id': home + '#person' },
    },
  ],
};
// escape `<` so no link/label value can ever break out of the <script> data block
const ldJson = JSON.stringify(ld).replace(/</g, '\\u003c');
// Umami analytics (cookieless, no personal data) is the ONLY third-party runtime, and only
// when a website id is configured — otherwise the CSP stays pure 'self'. The script loads
// from cloud.umami.is but SENDS pageviews to gateway.umami.is (its baked-in ingest host) —
// connect-src must allow the gateway or every visitor's browser silently drops the send.
const umamiScript = sources.umami ? ' https://cloud.umami.is' : '';
const umamiConnect = sources.umami ? ' https://cloud.umami.is https://gateway.umami.is' : '';
const csp = `default-src 'self'; script-src 'self'${umamiScript}; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src https:; font-src 'self'; connect-src 'self'${umamiConnect}; object-src 'none'; base-uri 'self'; form-action 'self'`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Defense-in-depth: GitHub Pages can't set headers, so CSP/referrer policy ride as metas.
         script-src 'self' works because ALL scripts are same-origin files (boot.js below +
         Astro's bundled module); style 'unsafe-inline' covers Astro's scoped <style> and the
         style attributes the motion code writes. JSON-LD data blocks are exempt from CSP. -->
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <!-- Progressive enhancement: mark JS active before paint, and guarantee the boot overlay,
         opacity:0 reveals, and hidden cursor can never leave a permanent black screen if the
         enhancement bundle is slow or fails to load. Blocking classic script by design —
         external (not inline) so the CSP needs no brittle hand-maintained hashes. -->
    <script is:inline src={base + 'boot.js'}></script>
    <noscript>
      <style>
        #intro, #cur, #sync, #glass { display: none !important; }
        .reveal { opacity: 1 !important; transform: none !important; filter: none !important; }
        body, body * { cursor: auto !important; }
      </style>
    </noscript>
    {/* privacy-friendly analytics (cookieless, honors Do Not Track) — only with an id set.
        set:html because the astro-check JSX parser rejects <script> inside an expression;
        the id is a build-time config constant, not user input. */}
    <Fragment set:html={sources.umami
      ? `<script defer src="https://cloud.umami.is/script.js" data-website-id="${sources.umami}" data-do-not-track="true"></script>`
      : ''} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <!-- wordmark favicon ("AE.") generated by scripts/generate.mjs — SVG has the glyphs
         as paths (no font fetch); PNG is the fallback for browsers without SVG favicons -->
    <link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml" />
    <link rel="icon" href={base + 'favicon.png'} type="image/png" sizes="128x128" />

    <!-- social / share cards -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.name} — ${site.tagline}`} />
    <script type="application/ld+json" set:html={ldJson} />
    <!-- fonts are self-hosted (see @fontsource imports); preload the hero's display weight -->
    <link rel="preload" as="font" type="font/woff2" href={chakra700Url} crossorigin />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <!-- build-log boot intro -->
    <div id="intro">
      <div id="intro-log"></div>
      <pre id="intro-banner" aria-hidden="true">{banner}</pre>
      <span class="caret" id="intro-caret">_</span>
      <button id="intro-skip" class="skip" type="button">skip ⏎</button>
    </div>

    <!-- lock-on bracket cursor -->
    <div id="cur"><span class="tl"></span><span class="tr"></span><span class="bl"></span><span class="br"></span></div>

    <!-- curved-glass overlay (curvature toggle) + drifting glare -->
    <div id="glass"><div id="glare"></div></div>
    <!-- rolling refresh/sync bar — the "alive" CRT signature (scanlines toggle) -->
    <div id="sync"></div>

    <Nav />

    <div id="controls">
      <button class="btn btn--contact" id="connect-btn" data-open="connect-modal" data-mag data-scramble="hover" aria-haspopup="dialog" aria-expanded="false">contact</button>
      <div class="menu">
        <button class="btn" id="dev-btn" data-mag data-scramble="hover" aria-haspopup="true" aria-expanded="false">dev</button>
        <div id="dev-panel" role="group" aria-label="Display options">
          <label class="tog" data-mag><input type="checkbox" id="t-sound" checked /><span class="box"></span><span>sound</span></label>
          <label class="tog" data-mag><input type="checkbox" id="t-crt" checked /><span class="box"></span><span>scanlines</span></label>
          <!-- curvature is opt-in (PLAN: heavy optical effects OFF by default) -->
          <label class="tog" data-mag><input type="checkbox" id="t-curve" /><span class="box"></span><span>curvature</span></label>
        </div>
      </div>
    </div>

    <div id="page">
      <div id="crt"></div>
      <main id="main"><slot /></main>
      <footer class="foot">© {year} {site.name} · <span class="foot__sys" data-scramble="periodic hover">sys·{site.codename}</span> · <a class="foot__contact" href={`mailto:${site.email}`} data-open="connect-modal" data-mag aria-haspopup="dialog" aria-expanded="false">get in touch ↗</a> · {site.url.replace('https://', '')} · built with Astro</footer>
    </div>

    <!-- persistent controls button + first-open controls card -->
    <button id="controls-btn" data-mag aria-label="Controls" aria-expanded="false">[ ? ]</button>
    <aside id="hud-controls" role="note" aria-live="polite" hidden>
      <button class="hud-x" data-hud-dismiss aria-label="dismiss controls">✕</button>
      <div class="hud-row"><span class="hud-k">move</span><span class="hud-v">◂ ▸ ▴ ▾ · wasd</span></div>
      <div class="hud-row"><span class="hud-k">select</span><span class="hud-v">enter</span></div>
      <div class="hud-row"><span class="hud-k">back</span><span class="hud-v">esc</span></div>
    </aside>

    <!-- contact / connect modal -->
    <div class="modal" id="connect-modal" role="dialog" aria-modal="true" aria-labelledby="connect-title">
      <div class="sheet">
        <h3 id="connect-title">Get in touch <button class="xbtn" type="button" data-close data-mag aria-label="Close">✕</button></h3>
        <div class="linklist">
          {links.map((l) => <a href={l.href} {...externalAttrs(l.href)} data-mag>{l.label} <span class="acc">↗</span></a>)}
        </div>
      </div>
    </div>


    <!-- Client enhancement bundle. Split by concern under src/scripts/ (this replaced a
         ~710-line inline script); Astro bundles it as one same-origin module, so CSP stays self. -->
    <script>
      import '../scripts/experience';
    </script>
  </body>
</html>
